POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=senior_script_kiddie
PORT=3000
# Admin login: on first start the backend creates the admin with password admin123.
# Sign in at http://localhost:3000, set a new password and connect an authenticator app.
# WebAuthn (Face ID / Touch ID) — defaults shown, override for other hosts:
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:3000
